# ==================================================================
#  CONFIGURACIÓN PORTABLE (copie este archivo como .env y edite)
#  Solo aquí se configuran la URI de producción y los datos requeridos.
# ==================================================================

# --- Aplicación ----------------------------------------------------
# Nombre comercial que se muestra en la interfaz.
APP_NAME="Opticenter"

# Entorno: local | production
APP_ENV=production

# true muestra errores en pantalla (solo en desarrollo).
APP_DEBUG=false

# URI base de la aplicación. En producción ponga aquí su dominio,
# ej: https://miodptica.com (sin barra final). También puede usar
# una subcarpeta, ej: https://miodptica.com/optica
APP_URL="https://tudominio.com"

# --- Base de datos (MySQL / MariaDB) --------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=optica_db
DB_USER=root
DB_PASS=

# --- Facturación electrónica SRI -----------------------------------
# Modo: test (pruebas) | production (producción)
SRI_MODE=test

# Establecimiento y punto de emisión (ej: "001" y "001").
SRI_PLAZA=
SRI_EMISSION_POINT=

# --- Notificación WhatsApp (lentes listos) --------------------------
# Mensaje que se envía al paciente cuando sus lentes están listos para
# retiro. La variable {nombre} se reemplaza por el nombre del paciente.
WHATSAPP_MENSAJE_LENTES_LISTOS="Estimado/a {nombre}, sus lentes ya están listos para retiro en nuestra óptica. ¡Gracias por su preferencia!"
