# Front Controller: todas las rutas van a index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /optica/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Bloques de seguridad
<FilesMatch "\.(env|log|md)$">
    Require all denied
</FilesMatch>
Options -Indexes